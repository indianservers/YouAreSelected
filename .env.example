# Server-only. Populate .env.local (ignored) locally and environment settings on Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_URL=http://localhost:3000
# One-time CLI bootstrap only; remove after successful setup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
# Optional real reset email delivery. No simulated email is sent if missing.
RESEND_API_KEY=
EMAIL_FROM=
# Isolated integration database only; never point these at production.
TEST_DATABASE_URL=
TEST_DATABASE_URL_UNPOOLED=
